# Copy this file to .env and fill in real values (commands.md, section 0, does it for you).
# .env is for the local scripts only. It never goes into the image:
# Cloud Run gets its settings from --set-env-vars at deploy time.

PROJECT_ID=your-gcp-project-id
LOCATION=us-central1

# The Cloud Run URL (fixed: service name + project number + region)
SERVICE_URL=https://REPLACE-ME-AFTER-DEPLOY.run.app

# Filled in AFTER topic 9's API Gateway deploy
GATEWAY_URL=https://REPLACE-ME-AFTER-GATEWAY-DEPLOY.gateway.dev
API_KEY=REPLACE-ME-AFTER-API-KEY-CREATE
