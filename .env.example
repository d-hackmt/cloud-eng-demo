# Copy this file to .env and fill in real values (commands.md, section 0, does it for you).
# .env is for the local scripts and a local container run. It never goes into the image:
# Cloud Run gets its settings from --set-env-vars at deploy time.

PROJECT_ID=your-gcp-project-id
REGION=us-central1
LOCATION=us-central1

SERVICE_NAME=moderaai
ARTIFACT_REPO=moderaai-repo

# "standard" (only flag genuinely abusive content) or "strict" (flag anything
# even mildly negative) — v1 uses standard, v2 uses strict, for the
# rollback demo in topic 5.
MODERATION_POLICY=standard

# Verify this is still a current, non-deprecated GA model ID at build time -
# Gemini model IDs retire on a schedule (e.g. gemini-2.0-flash-001 was
# discontinued June 1, 2026). Check the Vertex AI model garden if in doubt.
MODEL_NAME=gemini-2.5-flash
GEMINI_TIMEOUT_MS=10000
CACHE_TTL_SECONDS=3600
# Turns on ?simulate_hang and ?simulate_transient_failure (topics 7 and 8). Leave false outside a demo.
ENABLE_DEMO_SWITCHES=true

# Filled in AFTER the first deploy (topic 1) — paste the printed Cloud Run URL here
SERVICE_URL=https://REPLACE-ME-AFTER-DEPLOY.run.app

# Needed for topic 3 (CI/CD) — your GitHub username, for the trigger's --repo-owner
GITHUB_USERNAME=your-github-username

API_ID=moderaai-api
API_CONFIG_ID=moderaai-config
GATEWAY_ID=moderaai-gateway

# Filled in AFTER topic 9's API Gateway deploy
GATEWAY_URL=https://REPLACE-ME-AFTER-GATEWAY-DEPLOY.gateway.dev
API_KEY=REPLACE-ME-AFTER-API-KEY-CREATE
